{
  "manifest_version": 3,
  "name": "AI Sider",
  "version": "0.5.0",
  "description": "在侧边栏使用 17 个 AI 网页版（DeepSeek/ChatGPT/Claude/Gemini/Kimi/豆包…），支持 Ctrl 多选并排对比，并可将选中内容一键投递提问。",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "declarativeNetRequest",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "AI Sider",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://chatglm.cn/*",
        "https://www.qianwen.com/*",
        "https://yuanbao.tencent.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://chat.groq.com/*",
        "https://huggingface.co/chat/*",
        "https://pi.ai/*",
        "https://you.com/*"
      ],
      "js": ["content/ai-bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "unframe_ai_sites",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
